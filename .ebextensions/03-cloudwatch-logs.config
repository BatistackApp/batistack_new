# .ebextensions/03-cloudwatch-logs.config
files:
  "/opt/aws/amazon-cloudwatch-agent/etc/config.json":
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/app/current/storage/logs/laravel.log",
                  "log_group_name": "/aws/elasticbeanstalk/batistack-erp/application",
                  "log_stream_name": "{instance_id}/laravel.log",
                  "timestamp_format": "%Y-%m-%d %H:%M:%S"
                },
                {
                  "file_path": "/var/app/current/storage/logs/worker.log",
                  "log_group_name": "/aws/elasticbeanstalk/batistack-erp/workers",
                  "log_stream_name": "{instance_id}/worker.log"
                }
              ]
            }
          }
        }
      }

commands:
  01_create_log_groups:
    command: |
      aws logs create-log-group --log-group-name /aws/elasticbeanstalk/batistack-erp/application --region eu-west-3 || true
      aws logs create-log-group --log-group-name /aws/elasticbeanstalk/batistack-erp/workers --region eu-west-3 || true
