files:
  # Service systemd pour les workers Laravel
  "/etc/systemd/system/laravel-worker@.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Laravel Queue Worker %i
      After=network.target

      [Service]
      Type=simple
      User=webapp
      Group=webapp
      Restart=always
      RestartSec=3
      ExecStart=/usr/bin/php /var/app/current/artisan queue:work --sleep=3 --tries=3 --max-time=3600 --timeout=300
      StandardOutput=append:/var/app/current/storage/logs/worker.log
      StandardError=append:/var/app/current/storage/logs/worker.log

      [Install]
      WantedBy=multi-user.target

container_commands:
  01_reload_systemd:
    command: "systemctl daemon-reload"
    leader_only: false

  02_enable_workers:
    command: |
      for i in {1..4}; do
        systemctl enable laravel-worker@$i.service
        systemctl restart laravel-worker@$i.service
      done
    leader_only: false
