# .ebextensions/01-laravel.config
option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    memory_limit: 512M
    max_execution_time: 300
    upload_max_filesize: 50M
    post_max_size: 50M

  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: false
    LOG_CHANNEL: cloudwatch
    CACHE_DRIVER: redis
    SESSION_DRIVER: redis
    QUEUE_CONNECTION: redis
    FILESYSTEM_DISK: s3
    COMPOSER_ALLOW_SUPERUSER: 1

  aws:autoscaling:asg:
    MinSize: 2
    MaxSize: 10
    Cooldown: 300

  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    UpperThreshold: 70
    LowerThreshold: 20
    UpperBreachScaleIncrement: 1
    LowerBreachScaleIncrement: -1

  aws:elasticbeanstalk:environment:
    LoadBalancerType: application
    ServiceRole: aws-elasticbeanstalk-service-role

  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:eu-west-3:ACCOUNT_ID:certificate/CERT_ID

container_commands:
  01_optimize:
    command: "php artisan optimize"
    leader_only: false

  02_storage_link:
    command: "php artisan storage:link"
    test: "[ ! -L public/storage ]"
    leader_only: false

  03_filament_assets:
    command: "php artisan filament:assets"
    leader_only: false

files:
  "/etc/cron.d/laravel-scheduler":
    mode: "000644"
    owner: root
    group: root
    content: |
      * * * * * webapp cd /var/app/current && php artisan schedule:run >> /dev/null 2>&1
