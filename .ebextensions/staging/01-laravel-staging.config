# .ebextensions/staging/01-laravel-staging.config
option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    memory_limit: 512M
    max_execution_time: 300
    upload_max_filesize: 50M
    post_max_size: 50M
    display_errors: On  # ← DIFFÉRENCE : Afficher les erreurs en staging

  aws:elasticbeanstalk:application:environment:
    APP_ENV: staging  # ← DIFFÉRENCE
    APP_DEBUG: true  # ← DIFFÉRENCE : Debug activé
    LOG_LEVEL: debug  # ← DIFFÉRENCE : Logs verbeux
    LOG_CHANNEL: stack  # ← DIFFÉRENCE : Stack pour voir tous les logs
    CACHE_DRIVER: redis
    SESSION_DRIVER: redis
    QUEUE_CONNECTION: redis
    FILESYSTEM_DISK: s3
    COMPOSER_ALLOW_SUPERUSER: 1
    TELESCOPE_ENABLED: true  # ← NOUVEAU : Laravel Telescope pour debugging
    DEBUGBAR_ENABLED: true  # ← NOUVEAU : Laravel Debugbar

  # ← DIFFÉRENCE : Auto-scaling plus limité (économies)
  aws:autoscaling:asg:
    MinSize: 1  # Une seule instance minimum
    MaxSize: 3  # Maximum 3 instances
    Cooldown: 300

  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    UpperThreshold: 80  # Seuil plus haut
    LowerThreshold: 20
    UpperBreachScaleIncrement: 1
    LowerBreachScaleIncrement: -1

  aws:elasticbeanstalk:environment:
    LoadBalancerType: application
    ServiceRole: aws-elasticbeanstalk-service-role

  # ← DIFFÉRENCE : Certificat SSL différent pour staging
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:eu-west-3:ACCOUNT_ID:certificate/STAGING_CERT_ID

container_commands:
  01_optimize:
    command: "php artisan optimize"
    leader_only: false

  02_storage_link:
    command: "php artisan storage:link"
    test: "[ ! -L public/storage ]"
    leader_only: false

  03_filament_assets:
    command: "php artisan filament:assets"
    leader_only: false

  # ← NOUVEAU : Installer Telescope en staging
  04_telescope_install:
    command: "php artisan telescope:install"
    leader_only: true
    test: "[ ! -f config/telescope.php ]"
