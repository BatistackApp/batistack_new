# .ebextensions/02-supervisor.config
files:
  "/etc/supervisor/conf.d/laravel-worker.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      [program:laravel-worker]
      process_name=%(program_name)s_%(process_num)02d
      command=php /var/app/current/artisan queue:work redis --sleep=3 --tries=3 --max-time=600 --timeout=300
      autostart=true
      autorestart=true
      stopasgroup=true
      killasgroup=true
      user=webapp
      numprocs=4
      redirect_stderr=true
      stdout_logfile=/var/app/current/storage/logs/worker.log
      stopwaitsecs=600
      startsecs=0

commands:
  01_supervisor_install:
    command: "yum install -y supervisor"
    test: "[ ! -f /usr/bin/supervisord ]"

  02_supervisor_reread:
    command: "supervisorctl reread"

  03_supervisor_update:
    command: "supervisorctl update"

  04_supervisor_start:
    command: "supervisorctl start laravel-worker:*"
    ignoreErrors: true
