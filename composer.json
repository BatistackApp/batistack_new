{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/livewire-starter-kit",
    "type": "project",
    "description": "The official Laravel starter kit for Livewire.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-zip": "*",
        "achyutn/filament-log-viewer": "^2.3",
        "ariefng/filament-calculator": "^1.2",
        "batistackapp/activity-log": "^1.0@alpha",
        "batistackapp/filament-map-picker": "^1.0",
        "batistackapp/progress-stepper": "^1.0",
        "batistackapp/weather-widget": "^1.0",
        "bezhansalleh/filament-panel-switch": "^3.1",
        "caresome/filament-auth-designer": "^3.1",
        "chillerlan/php-qrcode": "*",
        "codewithkyrian/filament-date-range": "^2.2",
        "croustibat/filament-jobs-monitor": "^4.3",
        "devletes/filament-progress-bar": "^1.0",
        "docusealco/docuseal-php": "^1.0",
        "eduardoribeirodev/filament-leaflet": "^5.2",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.6",
        "flowframe/laravel-trend": "^0.5.0",
        "gheith3/filament-relation-pages": "^1.0",
        "google/cloud-vision": "^2.2",
        "guava/calendar": "^3.1",
        "harvirsidhu/filament-cards": "^1.0",
        "hugomyb/filament-media-action": "^5.0",
        "hydrat/filament-table-layout-toggle": "4.0",
        "intervention/validation": "^4.6",
        "joaopaulolndev/filament-pdf-viewer": "^3.0",
        "laravel-notification-channels/webpush": "^11.0",
        "laravel/fortify": "^1.34",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "livewire/flux": "^2.12.0",
        "livewire/livewire": "^4.1",
        "marcelorodrigo/filament-barcode-scanner-field": "^1.1",
        "nakanakaii/filament-countries": "^1.0",
        "nben/filament-record-nav": "^2.0",
        "opcodesio/log-viewer": "^3.24",
        "openplain/filament-tree-view": "^0.5.5",
        "picqer/php-barcode-generator": "^3.2",
        "qalainau/filament-inbox": "^1.0",
        "saade/filament-autograph": "^4.1",
        "setasign/fpdf": "^1.9",
        "setasign/fpdi": "^2.6",
        "spatie/browsershot": "^5.2",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-medialibrary": "^11.21",
        "tapp/filament-progress-bar-column": "^1.0",
        "tinusg/filament-company-logo-column": "^1.0",
        "tonegabes/filament-better-options": "^1.3",
        "tonegabes/filament-phosphor-icons": "^1.3",
        "vodafoneziggonl/filament-multi-widget": "^5.0",
        "zvizvi/user-fields": "^0.0.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
